# 本文件为模板。复制为 secrets.toml 并填入真实值。
# secrets.toml 已在 .gitignore 中，不会进版本库。
#
# 云端部署：Streamlit Cloud → 你的应用 → Settings → Secrets，填入同样的内容。
# 本地运行：直接把本文件复制为 secrets.toml 即可。
#
# ---------------------------------------------------------------------------
# 1) 访问密码（必填）
#    未配置时本地直进；云端配置后即启用密码门。
# ---------------------------------------------------------------------------
APP_PASSWORD = "在这里填访问密码"

# ---------------------------------------------------------------------------
# 2) AI 深度解读（可选，本��统一提供，所有访问者共用同一份）
#
#    配置后所有访问者共用一个密钥，无需任何人输入或看到密钥。
#    不配置时该功能显示为"尚未开通"，图表与行为测量不受影响。
#
#    测量结论始终由本地确定性算法给出，模型只负责把原始决策流水讲成
#    自然语言，两者是分开的——密钥只影响"解读"这一段文字，不影响任何数字。
# ---------------------------------------------------------------------------
ANALYSIS_API_KEY = "sk-..."
ANALYSIS_BASE_URL = "https://api.deepseek.com"
ANALYSIS_MODEL = "deepseek-chat"

#    分享出的结果卡与二维码指向的公开地址，留空则用代码里的默认值。
# ANALYSIS_APP_URL = "https://fittest-edu.streamlit.app/"

#    若接口需要经过本地代理才能连通（国内直连境外模型服务常不通），
#    由维护者在此固定配置，使用者无需关心。
# ANALYSIS_PROXY = "http://127.0.0.1:7890"

#    兼容写法：也可用下面这些名字提供密钥
# DEEPSEEK_API_KEY = "sk-..."
# OPENAI_API_KEY = "sk-..."

# ---------------------------------------------------------------------------
# 3) 教师码（要收名单才需要）
#
#    首页「教师端：整批名单导出与恢复」那道门。加入码是学生取回自己报告的唯一
#    凭据，而访问密码全班共用，所以这一屏单独设一道门——不配置时整块名单不渲染，
#    而不是默认给大家看。
# ---------------------------------------------------------------------------
# TEACHER_GATE = "只有老师知道的码"
