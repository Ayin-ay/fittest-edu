# 本文件为模板。复制为 secrets.toml 并填入真实值。
# secrets.toml 已在 .gitignore 中，不会进版本库。
#
# 云端部署：Streamlit Cloud → 你的应用 → Settings → Secrets，填入同样的内容。
# 本地运行：直接把本文件复制为 secrets.toml 即可。
#
# ---------------------------------------------------------------------------
# 1) 访问密码（必填）
#    未配置时本地直进；云端配置后即启用密码门。
# ---------------------------------------------------------------------------
APP_PASSWORD = "在这里填访问密码"

# ---------------------------------------------------------------------------
# 2) AI 深度解读（可选，全部访问者共用同一份）
#
#    配置后所有访问者共用一个密钥，无需任何人输入或看到密钥。
#    不配置时该功能显示为"尚未开通"，图表与行为测量不受影响。
#
#    --- 方案 A：TokenDance（推荐，可按应用归因）---
#    TokenDance 是 OpenAI 兼容网关，base_url 必须带 /v1。
#    平台按 App URL 归因收益，模型消耗会记到本应用名下。
#    模型名可从 https://tokendance.space/gateway/v1/models 核对。
#
# ANALYSIS_API_KEY  = "sk-tp-..."
# ANALYSIS_BASE_URL = "https://tokendance.space/gateway/v1"
# ANALYSIS_MODEL    = "qwen3.8-max"
#
#    模型名要挑「你这个产品方账号真的有分润」的那个，不要照模型目录选最新的。
#    实测：qwen3.8-max 有分润；qwen3.8-max-0902 与 glm-5.1 均为 ¥0。
#    公开价目表不一定等于账户实际结算，以后台「分润价目」页为准。
#
#    --- 方案 B：DeepSeek 官方 ---
#    base_url 与模型名必须与你的账户一致。
# ---------------------------------------------------------------------------
ANALYSIS_API_KEY = "sk-..."
ANALYSIS_BASE_URL = "https://api.deepseek.com"
ANALYSIS_MODEL = "deepseek-chat"

# ---------------------------------------------------------------------------
# 3) 应用归因（仅 TokenDance 方案需要）
#
#    TokenDance 只凭 App URL 归因，值必须与报名表里填的完全一致，
#    **包括尾斜杠**；差一个字符就归因不上。留空则用代码里的默认值。
# ---------------------------------------------------------------------------
# ANALYSIS_APP_URL = "https://the-fittest.streamlit.app/"

#    若接口需要经过本地代理才能连通（国内直连境外模型服务常不通），
#    由维护者在此固定配置，使用者无需关心。
# ANALYSIS_PROXY = "http://127.0.0.1:7890"

#    兼容写法：也可用下面这些名字提供密钥
# DEEPSEEK_API_KEY = "sk-..."
# OPENAI_API_KEY = "sk-..."
