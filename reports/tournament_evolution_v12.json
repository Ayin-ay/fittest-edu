        1.0,
        1.0
      ]
    },
    "allocation": {
      "ALPHA_ALLOCATE": 0.4,
      "note": "下一代规模 = 当代规模 * (ALPHA_ALLOCATE + (1-ALPHA_ALLOCATE) * 适应度/平均适应度)"
    },
    "extinction": {
      "EXTINCTION_SIZE": 3,
      "EXTINCTION_STREAK": 3,
      "EXTINCTION_FITNESS_RATIO": 0.5,
      "note": "物种（亚种除外）规模不大于 EXTINCTION_SIZE 时淘汰；分配后与每代结束时各检查一次；连续 EXTINCTION_STREAK 代混合适应度低于平均值 EXTINCTION_FITNESS_RATIO 倍时淘汰"
    },
    "subspecies": {
      "SUBSPECIES_MIN_SIZE": 10,
      "SUBSPECIES_MIN_RATIO": 0.35,
      "SUBSPECIES_EXTINCTION_STREAK": 3,
      "SUBSPECIES_STALL_GENERATIONS": 10,
      "ALPHA_INVASION": 0.4,
      "note": "亚种达到规模或占比阈值之一即独立；连续低适应度达阈值则淘汰并归还规模；规模恒为 1 达 SUBSPECIES_STALL_GENERATIONS 代则淘汰"
    },
    "mutation": {
      "MUTATION_MIN_SIZE": 10,
      "MAX_MUTATION_ATTEMPTS": 4,
      "MUTATION_WEIGHTS": {
        "parameter": 25,
        "jump": 8,
        "replace": 15,
        "add": 10,
        "delete": 30,
        "swap": 4,
        "fresh": 4,
        "inherit": 4
      },
      "probability_by_size": {
        "<=10": 0.0,
        "<=20": 0.05,
        "<=40": 0.1,
        "<=70": 0.15,
        ">70": 0.2
      }
    },
    "stagnation": {
      "STAGNATION_SEATS": 2,
      "STAGNATION_GENERATIONS": 20,
      "note": "当一代内换手的席位不超过 STAGNATION_SEATS 时累计静止计数，达到 STAGNATION_GENERATIONS 则按规模加权强制一次变异"
    }
  },
